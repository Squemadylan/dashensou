<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/tvUpdateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_medium"
        android:lineSpacingMultiplier="1.2" />

    <ProgressBar
        android:id="@+id/progressUpdate"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvUpdateProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_small"
        android:visibility="gone" />

</LinearLayout>
