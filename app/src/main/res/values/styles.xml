<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.DaShenSou.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/shape_lg</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.DaShenSou.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/shape_lg</item>
        <item name="android:textSize">@dimen/text_size_normal</item>
    </style>
    <style name="Widget.DaShenSou.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>
    <style name="Widget.DaShenSou.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.DaShenSou.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/shape_xl</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/colorSurfaceContainerLow</item>
    </style>
    <style name="Widget.DaShenSou.Card.Surface" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/shape_xl</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorSurfaceContainer</item>
    </style>
</resources>
